{
  "name": "hexo-theme-carpediem",
  "version": "3.0.0",
  "description": "TSX renderer for Hexo",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "dev": "tsc -w",
    "dev:scripts": "tsc -p tsconfig.scripts.json -w",
    "dev:all": "concurrently \"npm run dev:scripts\" \"npm run storybook --static source\"",
    "prepublishOnly": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "npm run lint:ts && npm run lint:style",
    "lint:ts": "eslint --ext .js,.jsx,.ts,.tsx src layout",
    "lint:ts:fix": "eslint --ext .js,.jsx,.ts,.tsx src layout --fix",
    "lint:style": "stylelint \"src/**/*.scss\" \"layout/**/*.scss\"",
    "lint:style:fix": "stylelint \"src/**/*.scss\" \"layout/**/*.scss\" --fix",
    "prepare": "husky",
    "type-check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit"
  },
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "classnames": "^2.5.1",
    "cssnano": "^7.0.7",
    "feather-icons-react": "^0.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@babel/register": "^7.27.1",
    "@storybook/addon-a11y": "^9.0.15",
    "@storybook/addon-docs": "^9.0.12",
    "@storybook/addon-onboarding": "^9.0.12",
    "@storybook/addon-styling-webpack": "^2.0.0",
    "@storybook/addon-webpack5-compiler-swc": "^3.0.0",
    "@storybook/react-webpack5": "^9.0.12",
    "@types/hexo": "^7.0.0",
    "@types/jest": "^30.0.0",
    "@types/memory-fs": "^0.3.7",
    "@types/node": "^24.0.3",
    "@types/postcss-preset-env": "^7.7.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "autoprefixer": "^10.4.21",
    "chokidar": "^4.0.3",
    "concurrently": "^9.1.2",
    "css-loader": "^6.11.0",
    "esbuild": "^0.25.6",
    "esbuild-register": "^3.6.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.3.0",
    "eslint-plugin-stylelint": "^0.1.1",
    "glob": "^11.0.3",
    "hexo": "^7.3.0",
    "husky": "^9.1.7",
    "jest": "^30.0.2",
    "lint-staged": "^16.1.2",
    "memory-fs": "^0.5.0",
    "mini-css-extract-plugin": "^2.9.2",
    "mkdirp": "^3.0.1",
    "postcss": "^8.5.6",
    "postcss-modules": "^6.0.1",
    "postcss-preset-env": "^10.2.4",
    "prop-types": "^15.8.1",
    "sass": "^1.89.2",
    "sass-loader": "^16.0.5",
    "storybook": "^9.0.12",
    "storybook-css-modules": "^1.0.8",
    "style-loader": "^4.0.0",
    "stylelint": "^16.21.0",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-recess-order": "^7.1.0",
    "stylelint-config-recommended-scss": "^15.0.1",
    "stylelint-config-standard": "^38.0.0",
    "stylelint-config-standard-scss": "^15.0.1",
    "stylelint-order": "^7.0.0",
    "stylelint-prettier": "^5.0.3",
    "terser": "^5.43.1",
    "ts-dedent": "^2.2.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.3",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1"
  },
  "peerDependencies": {
    "hexo": ">=6.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --ext .js,.jsx,.ts,.tsx src"
    ],
    "*.scss": [
      "stylelint \"src/**/*.scss\" \"layout/**/*.scss\""
    ]
  }
}
