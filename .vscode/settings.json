{
  "emmet.includeLanguages": {
    "scss": "css",
    "*.module.scss": "css"
  },
  "editor.codeActionsOnSave": {
    "source.fixAll.stylelint": "explicit"
  },
  "stylelint.validate": [
    "css",
    "scss"
  ],
  "cSpell.words": [
    "autodocs",
    "contenteditable",
    "tabindex"
  ],
  "kiroAgent.configureMCP": "Disabled"
}
